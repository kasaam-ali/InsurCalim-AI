# InsurCalim AI landing page client config template.
# Copy to ".env.local" (git-ignored) to override. Vite only exposes VITE_* vars.
#
# NOTE (demo only): Vite inlines these values into the client bundle, and the
# Streamlit dashboard on 8501 is directly reachable, so this is a demo gate,
# not real authentication. Do not put real secrets here.

# Where the React investigator dashboard is served (primary hand-off target).
VITE_DASHBOARD_URL=http://localhost:5174

# Where the classic Streamlit dashboard is served (secondary link).
VITE_STREAMLIT_URL=http://localhost:8501

# Demo sign-in credentials (must match the dashboard's APP_USERNAME / APP_PASSWORD).
VITE_APP_USERNAME=admin
VITE_APP_PASSWORD=insurclaim2026

# Shared hand-off token (must match the dashboard's APP_LOGIN_TOKEN).
VITE_APP_LOGIN_TOKEN=insurclaim-demo-2026
