# InsurCalim AI — environment variables template
# Copy this file to ".env" and fill in your real values.
# The ".env" file is git-ignored, so real secrets never get committed.

# --- LLM providers ---
# OpenRouter (preferred during development) — https://openrouter.ai/keys
# Reaches Claude models cheaply so the direct Opus quota is saved for the pitch.
OPENROUTER_API_KEY=your-openrouter-key-here

# Claude (direct — used for the real demo/pitch) — https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-key-here

# Gemini (fallback) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here

# Groq (fallback) — https://console.groq.com/keys
GROQ_API_KEY=your-groq-key-here

# --- Model names (change here instead of hard-coding in the code) ---
# OpenRouter dev tiers (cheap): reasoning = Sonnet, extraction = Haiku.
OPENROUTER_REASONING_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_EXTRACTION_MODEL=anthropic/claude-haiku-4.5
# Direct Anthropic models (used when OpenRouter key is removed).
CLAUDE_REASONING_MODEL=claude-opus-4-8
CLAUDE_EXTRACTION_MODEL=claude-haiku-4-5

# --- PostgreSQL (used from Phase 1; matches docker-compose defaults) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insurclaim
POSTGRES_USER=insurclaim
POSTGRES_PASSWORD=change-me-locally
