# InsurCalim AI dashboard client config template.
# Copy to ".env.local" (git-ignored) to override. Vite only exposes VITE_* vars.

# API base. In dev, leave as /api (Vite proxies it to the Starlette API on 8000).
# In a static build, point this at the deployed API origin, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where "Log out" and the sign-in gate send the user.
VITE_LANDING_URL=http://localhost:5173
